/.idea
*.iml
.vscode
__pycache__

# Local overrides: secrets, identity, machine specifics.
# Never versioned — only the *.example templates are.
*.local
!*.local.example
.zshenv.local
.zshrc.local
.gitconfig.local

# Transient files written by the Claude Code harness
.claude/*.tmp.*

# mise: machine-local overrides next to the versioned config and lock
mise/*.local.toml
mise/*.local.lock
