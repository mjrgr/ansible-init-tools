---
extends: default

ignore: |
  .github/

rules:
  line-length:
    max: 160
    level: warning
  # Ansible playbooks conventionally omit the leading --- on the play file.
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
  comments:
    min-spaces-from-content: 1
  # ansible-lint requires this off, and disagreeing costs its --fix mode.
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
