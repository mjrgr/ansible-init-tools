#!/usr/bin/env bash
#MISE description="Preflight (zsh, git, curl, fc-cache) and the target directory tree"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../scripts/lib/dotfiles.sh"

[[ -f "$DOTFILES/zsh/.zshrc" ]] || die "dotfiles source not found: $DOTFILES"

# Fail here rather than midway through the oh-my-zsh installer, which reports
# "Zsh is not installed" and leaves a half-built ~/.oh-my-zsh behind.
missing=()
for cmd in zsh git curl fc-cache; do have "$cmd" || missing+=("$cmd"); done
if (( ${#missing[@]} )); then
  die "missing command(s): ${missing[*]} — run scripts/bootstrap.sh first"
fi

for d in .config .config/zsh .config/wezterm .config/btop .config/herdr .config/krelay \
         .claude .kube .local/bin; do
  ensure_dir "$HOME/$d"
done
ensure_dir "$BACKUP_DIR"
