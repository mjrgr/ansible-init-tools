#!/usr/bin/env bash
#MISE description="Install the kubectl krew plugins that are missing (KREW_ROOT, default ~/.krew)"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../scripts/lib/dotfiles.sh"

plugins=(access-matrix cert-manager cnpg ctx ns relay stern whoami)
have kubectl-krew || die "kubectl-krew not installed — run mise install first"

export KREW_ROOT="${KREW_ROOT:-$HOME/.krew}"
if [[ ! -d "$KREW_ROOT/index/default" ]]; then
  kubectl-krew update >/dev/null 2>&1
  changed "krew index initialised"
fi

installed="$(kubectl-krew list 2>/dev/null || true)"
for p in "${plugins[@]}"; do
  grep -qx "$p" <<<"$installed" && continue
  # Some plugins ship no build for every arch (access-matrix has no linux/arm64).
  if out="$(kubectl-krew install "$p" 2>&1)"; then
    changed "krew plugin $p"
  elif grep -q 'does not offer installation for this platform' <<<"$out"; then
    say "krew: no $(uname -m) build for $p"
  else
    printf '%s\n' "$out" >&2; die "krew install $p failed"
  fi
done
