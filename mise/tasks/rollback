#!/usr/bin/env bash
#MISE description="Unlink every [dotfiles] entry, un-register the Claude hooks, stop the publisher unit"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../scripts/lib/dotfiles.sh"

# The unit's file is one of the entries: stop it before the link goes.
if [[ -S "/run/user/$(id -u)/systemd/private" ]] && systemctl --user is-enabled --quiet herd-publish.service 2>/dev/null; then
  systemctl --user disable --now herd-publish.service; changed "disabled herd-publish.service"
fi

# settings.json was merged, not linked: take our own event keys back out and leave the rest alone.
settings="$HOME/.claude/settings.json"
if [[ -f "$settings" ]] && [[ "$(python3 "$REPO/scripts/lib/claude-settings.py" unhooks "$settings" "$HOME/.config/wezterm/claude-state-hook.sh")" == "changed" ]]; then
  changed "Claude Code state hooks un-registered from $settings"
fi

# btop themes is linked by the bootstrap task, not declared, so it goes by hand.
if [[ -L "$HOME/.config/btop/themes" ]]; then rm -f "$HOME/.config/btop/themes"; changed "unlinked ~/.config/btop/themes"; fi

# ~/.config/mise is the last entry mise removes: the config it reads lives behind it,
# so this runs from the clone (`mise --cd <clone> dot unapply` works too).
before="$(mise dot status 2>/dev/null | grep -c 'applied' || true)"
mise dot unapply --yes 2>&1 | sed 's/^/  /'
changed "unlinked $before dotfiles entr(y|ies)"

say "Kept: the three *.local files, ~/.oh-my-zsh, the fonts, the tools under ~/.local/share/mise."
say "Not reverted: the login shell (chsh -s /bin/bash), the system packages (mise bootstrap packages status)."
