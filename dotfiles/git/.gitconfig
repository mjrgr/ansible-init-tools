# Versioned in ansible-init-tools — deployed by playbooks/dotfiles.yml.
# Identity, credential helper and machine settings live in ~/.gitconfig.local.

[include]
	path = ~/.gitconfig.local

[branch]
	autoSetupMerge = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[safe]
	directory = *

# ─── DELTA ───────────────────────────────────────────────────────────────────
# The `delta` role installs it, but dotfiles.yml does not require install_clis.yml
# to have run — and a core.pager naming a missing binary breaks every command
# that paginates, not just diffs. Hence the guard: git hands the value to sh, so
# an `if` is enough, and unlike `delta || less` it cannot fall through to less
# when delta exits non-zero (quitting the pager early does exactly that).
[core]
	pager = "if command -v delta >/dev/null 2>&1; then delta; else less; fi"
[interactive]
	diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"

[delta]
	navigate = true          # n / N jump between files, as in less
	line-numbers = true
	hyperlinks = true
	# Without this, delta emits a bare file:// URL and a click lands at line 1.
	# The code package registers the vscode:// scheme with xdg, so wezterm needs
	# nothing of its own — OpenLinkAtMouseCursor hands the URL to the desktop.
	hyperlinks-file-link-format = "vscode://file/{path}:{line}"
	syntax-theme = base16    # follows the terminal palette, like BAT_THEME in .zshrc

# zdiff3 keeps the common ancestor in the conflict block; delta renders it as a
# third pane instead of the bare <<<<<<< markers.
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
