---
exclude_paths:
  - test/
  - .github/

skip_list:
  # What is left on shell is a version probe and three gpg --dearmor calls, both
  # of which report their own idempotence: the probe through changed_when: false,
  # the dearmors through creates:. Binary installs go through get_url/unarchive.
  - command-instead-of-shell
  - no-changed-when

warn_list:
  - experimental
